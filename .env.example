# Elivo Payout Guard — environment (all optional; defaults shown).
# Testnet prototype. Payout firms and SPEI receipts are simulated. Contract unaudited.

# sandbox (local, default) or testnet
ELIVO_NETWORK=sandbox
# RPC endpoint. Default: local sandbox; on testnet https://test.rpc.fastnear.com
# NEAR_RPC_URL=
# Extra RPCs to rotate through on rate limits (comma-separated). Testnet default:
# NEAR_RPC_FALLBACKS=https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org

# Service ports (all bind to 127.0.0.1)
ROUTER_PORT=7400
ORACLE_PORT=7410
MX1_PORT=7421
MX2_PORT=7422
MX3_PORT=7423

# Router: wait this long past a cut-off before rerouting (ms). Real-time mode would use 300000.
GRACE_MS=5000
# Router poll interval (ms). Default 1000 on sandbox, 4000 on testnet.
# POLL_MS=
# Payout cut-off and final deadline after funding (s). Cut-off default: 40 sandbox, 120 testnet.
# CUTOFF_IN_S=
DEADLINE_IN_S=300
# Fixed, simulated FX rate
MXN_PER_USDC=18.50

# Service processes (set by `make demo` automatically; listed for completeness)
# ESCROW_ID=            escrow contract account
# ROUTER_URL=           oracle → router
# ORACLE_URL=           firms → oracle
# MX1_URL= MX2_URL= MX3_URL=   router → firms
# DEPLOYMENT=           path to a deployment JSON (router)
# ROUTER_STORE=         router's local JSON store (default .data/router-<network>.json)
# ROUTER_FC_SECRET_KEY= router function-call key (ed25519:...)
# RECEIPT_SECRET_KEY=   receipt signing key
# ORACLE_SECRET_KEY=    oracle signing key
# FIRM= FIRM_ACCOUNT= FIRM_SECRET_KEY= FIRM_MODE=ok|late|fail   firm simulator
