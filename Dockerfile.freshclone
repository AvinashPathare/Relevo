# Fresh-clone check: builds the repo from a clean copy and runs what the README says.
#   git archive HEAD | docker build -f Dockerfile.freshclone -t elivo-freshclone -
#   docker run --rm elivo-freshclone
# Debian 13: the NEAR sandbox binary (2.14) needs glibc >= 2.38; Debian 12 ships 2.36.
# cargo-near ships prebuilt binaries only for x86_64 Linux. On x86_64 this runs the full `make test`
# (including the wasm rebuild). On aarch64 it skips the wasm rebuild and runs the contract tests against
# the committed wasm in contracts/res (CI on x86_64 covers the rebuild).
FROM node:22-trixie
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.95.0 -t wasm32-unknown-unknown -c clippy -c rustfmt
ENV PATH="/root/.cargo/bin:${PATH}"
RUN if [ "$(uname -m)" = "x86_64" ]; then \
      curl --proto '=https' --tlsv1.2 -LsSf https://github.com/near/cargo-near/releases/download/cargo-near-v0.23.0/cargo-near-installer.sh | sh; \
    fi \
 && corepack enable && corepack prepare pnpm@10.30.0 --activate
WORKDIR /repo
COPY . .
RUN make setup
CMD ["bash", "-c", "set -e; pnpm build:web; make demo; pnpm test:e2e; if command -v cargo-near >/dev/null; then make test; else make test-ts && cargo test --workspace; fi; echo FRESH-CLONE-CHECK-PASSED"]
